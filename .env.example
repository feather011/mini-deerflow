# ---- 模型 Provider（21A）----
# 配置优先级：系统环境变量 > .env > 代码默认值
#   · 系统环境变量（容器/CI 注入）始终优先
#   · .env 用于本地开发，只补齐系统环境里没有的项
#
# 可选：fake（默认）| minimax | mimo
#   fake    不联网、行为确定，测试与本地开发无需任何 Key
#   minimax 小米… 不，是 MiniMax 官网 Anthropic 兼容接口
#   mimo    小米 MiMo Anthropic 兼容接口
# 选真实 provider 但缺对应 Key 时启动失败，不会静默降级回 fake。
MINI_DEERFLOW_MODEL_PROVIDER=fake

# ---- 传输层（两个 Anthropic 兼容提供方共用，不挂在任何供应商名下）----
# MINI_DEERFLOW_MODEL_TIMEOUT_SECONDS=60
# MINI_DEERFLOW_MODEL_MAX_RETRIES=2

# ---- MiniMax（provider=minimax）----
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
# MINIMAX_MODEL=MiniMax-M3

# ---- 小米 MiMo（provider=mimo）----
# MIMO_API_KEY=
# MIMO_BASE_URL=https://api.xiaomimimo.com/anthropic
# MIMO_MODEL=mimo-v2.6-flash

# 以下旧变量**不再被读取**，保留说明以免误用：
#   DASHSCOPE_API_KEY  属于阿里云 DashScope，复用会串用凭据
#   BASE_URL/MODEL_NAME 名字过于通用，易与无关进程的环境变量撞名
#   MINIMAX_TIMEOUT_SECONDS / MINIMAX_MAX_RETRIES 已去提供方化，改用上面的 MINI_DEERFLOW_MODEL_*
#
# 注意：MIMO_API_KEY / MIMO_BASE_URL / MIMO_MODEL 曾被当作 MiniMax 的别名而移除，
# 现在它们是 mimo provider 的**正式变量**——语义是「提供方各自的配置」，
# 不再是「别人的别名」。

# ---- 上下文工程（24）----
# 全部可省略：不设置时走代码默认值，行为与之前完全一致。
# 这里只读环境，不在 import / create_app() 阶段建立任何数据库连接。

# 总开关。0 = 关闭上下文工程（不建 ContextStore、不注册 task_note / history_* 工具）
# MINI_DEERFLOW_CONTEXT_ENABLED=1

# ContextState 持久化路径。不设置 → 内存实现（进程重启后摘要与笔记不保留）
# 与 MINI_DEERFLOW_DB_PATH 分开：一个是事实源（线程消息），一个是投影（摘要/笔记/水位）
# MINI_DEERFLOW_CONTEXT_DB_PATH=/data/mini-deerflow-context.db

# 单次模型调用的 Token 预算
# MINI_DEERFLOW_CONTEXT_MAX_TOKENS=80000
# MINI_DEERFLOW_CONTEXT_RESERVED_OUTPUT_TOKENS=4096
# MINI_DEERFLOW_CONTEXT_SAFETY_MARGIN_TOKENS=2048

# 触发压缩的软阈值，取值 (0, 1]；0.8 = 用到硬上限的 80% 时压最旧的消息组
# MINI_DEERFLOW_CONTEXT_COMPACTION_THRESHOLD=0.8
